{
  "info": {
    "name": "QA_Suite_Reqres",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Crear Usuario QA",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Validar contrato y datos recibidos\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res).to.have.property(\"id\");",
              "    pm.expect(res.name).to.eql(\"Jose Gomez\");",
              "    pm.expect(res.job).to.eql(\"QA Automation Engineer\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Jose Gomez\",\n  \"job\": \"QA Automation Engineer\"\n}"
        },
        "url": {
          "raw": "https://reqres.in/api/users",
          "protocol": "https",
          "host": [
            "reqres",
            "in"
          ],
          "path": [
            "api",
            "users"
          ]
        }
      },
      "response": []
    }
  ]
}
